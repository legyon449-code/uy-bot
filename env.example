# BotFather'dan olingan bot tokeningiz
BOT_TOKEN=123456789:AA...................

# Siz - adminning Telegram user ID raqami (raqam bo'lishi kerak, @username emas)
# Buni bilish uchun @userinfobot ga /start yozing
ADMIN_ID=123456789

# Serverning tashqi manzili (Render sizga beradigan URL), oxirida / bo'lmasin
# Masalan: https://uy-bot.onrender.com
BASE_URL=https://your-app-name.onrender.com

# Har safar necha kishi taklif qilish talab qilinsin (standart: 5)
INVITE_STEP=5

# Server porti (Render o'zi PORT beradi, lokal uchun 3000)
PORT=3000
